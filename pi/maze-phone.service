# Пульт запуска с телефона (phone_web.py): http://<IP робота>/ - кнопки
# «Запустить» / «Стоп» для nav.py. Поднимается сразу после загрузки Pi.
# KillMode=process: перезапуск или остановка этого сервиса не трогает уже
# идущий заезд (nav.py в своём сеансе). Порт 80 - через CAP_NET_BIND_SERVICE.
#
# Установка (на Pi, один раз):
#   sudo cp ~/maze/maze-phone.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now maze-phone
# Лог:  journalctl -u maze-phone -f

[Unit]
Description=MAZE2027 phone launcher (phone_web.py)
After=network.target

[Service]
Type=simple
User=madness
Group=madness
SupplementaryGroups=i2c
WorkingDirectory=/home/madness/maze
ExecStart=/home/madness/maze/venv/bin/python -u /home/madness/maze/phone_web.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
